root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

# 构建产物原样保留：这里是上游 dist/ 的逐字节副本，编辑器不得改动行尾或缩进。
[web/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

[web/index.html]
insert_final_newline = unset
trim_trailing_whitespace = unset
